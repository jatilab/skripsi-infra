          "expr": "label_replace(\n  histogram_quantile(0.50,\n    sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket{service=~\"$service.*\"}[$interval]))\n  ),\n  \"service\", \"$1\", \"service\", \"([^-]+-[^-]+).*\"\n)",
          "legendFormat": "{{service}}",
          "range": true,
          "refId": "A"
        }
