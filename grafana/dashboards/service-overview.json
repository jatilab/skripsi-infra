        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (container_label_com_docker_swarm_service_name) (\n  rate(container_cpu_usage_seconds_total{container_label_com_docker_swarm_service_name=~\"$swarm_service\", container_label_com_docker_swarm_service_name!=\"\"}[$interval])\n)\n/\nsum by (container_label_com_docker_swarm_service_name) (\n  (container_spec_cpu_quota{container_label_com_docker_swarm_service_name=~\"$swarm_service\", container_label_com_docker_swarm_service_name!=\"\"} > 0)\n  / container_spec_cpu_period{container_label_com_docker_swarm_service_name=~\"$swarm_service\", container_label_com_docker_swarm_service_name!=\"\"}\n)",
